# Plint configuration. Copy to .env and fill in. No real values belong in this
# file: it is committed. .env is not.

# ---------------------------------------------------------------- database
PGHOST=
PGPORT=5432
PGDATABASE=

# TLS to the database: disable | require | verify-ca | verify-full
# Defaults to `require` unless NODE_ENV=development, which defaults to
# `disable`. verify-ca and verify-full additionally need PGSSLROOTCERT.
PGSSLMODE=
PGSSLROOTCERT=

# The runtime role. Not a superuser, not BYPASSRLS, does not own the tables.
# Buyer isolation depends on all three being true.
PGUSER=
PGPASSWORD=

# The owning role. Runs migrations and the development seed. The server never
# connects with this.
PGADMINUSER=
PGADMINPASSWORD=

# ------------------------------------------------------------------- server
# Set to `development` ONLY on a developer machine. Anything else, including
# unset, is treated as production: database TLS on and Secure cookies.
NODE_ENV=
PORT=3000

# Signs session cookies. 32+ random bytes. Rotating it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLINT_SECRET=

# Set to 1 ONLY for local http development. Anything else and cookies are
# marked Secure, which means a plain-http browser will not send them back.
PLINT_INSECURE_COOKIES=

# Where uploaded evidence photographs are stored. Content-addressed within.
PLINT_EVIDENCE_DIR=
